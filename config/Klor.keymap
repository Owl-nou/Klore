#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <10000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <3000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "hold-preferred";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <200>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <200>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <200>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <200>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;

            tap-ms = <10>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;

            tap-ms = <10>;
        };
    };

    macros {
        Full_Prt_Scr: Full_Prt_Scr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp PRINTSCREEN>;
            label = "FULL_PRT_SCR";
        };

        Triple_left_click: Triple_left_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &mkp LCLK &mkp LCLK>;
            label = "TRIPLE_LEFT_CLICK";
        };

        Xen_man_hinh: Xen_man_hinh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PRINTSCREEN &to 3>;
            label = "XEN_MAN_HINH";
        };

        CSA: CSA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_wait_time 2000>,
                <&sk LEFT_CONTROL &sk LEFT_SHIFT &sk LEFT_ALT>,
                <&macro_release>;

            label = "CSA";
        };

        Mui_ten_thuan: Mui_ten_thuan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp MINUS &kp GREATER_THAN &kp SPACE>;
            label = "MUI_TEN_THUAN";
        };

        Mui_ten_nguoc: Mui_ten_nguoc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp MINUS &kp MINUS &kp SPACE>;
            label = "MUI_TEN_NGUOC";
        };

        CW: CW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_GUI>,
                <&macro_release>;

            label = "CW";
        };

        Thu_nho_tab: Thu_nho_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp SPACE>,
                <&macro_release>,
                <&kp T>;

            label = "THU_NHO_TAB";
        };
    };

    combos {
        compatible = "zmk,combos";

        sym1 {
            bindings = <&kp EXCLAMATION>;
            key-positions = <23 24>;
            layers = <0>;
        };

        sym2 {
            bindings = <&kp AT_SIGN>;
            key-positions = <24 25>;
            layers = <0>;
        };

        sym3 {
            bindings = <&kp HASH>;
            key-positions = <25 26>;
            layers = <0>;
        };

        sym4 {
            bindings = <&kp DOLLAR>;
            key-positions = <26 27>;
            layers = <0>;
        };

        sym5 {
            bindings = <&kp PERCENT>;
            key-positions = <28 29>;
            layers = <0>;
        };

        sym6 {
            bindings = <&kp CARET>;
            key-positions = <29 30>;
            layers = <0>;
        };

        sym7 {
            bindings = <&kp AMPERSAND>;
            key-positions = <30 31>;
            layers = <0>;
        };

        sym8 {
            bindings = <&kp ASTERISK>;
            key-positions = <31 31 32 31>;
            layers = <0>;
        };

        Mo_ngoac_nhon {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <11 12>;
            layers = <0>;
        };

        Dong_ngoac_nhon {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <20 19>;
            layers = <0>;
        };

        Mo_ngoac_vuong {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <12 13>;
            layers = <0>;
        };

        Dong_ngoac_vuong {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 18>;
            layers = <0>;
        };

        Mo_ngoac_don {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <13 14>;
            layers = <0>;
        };

        Dong_ngoac_don {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 17>;
            layers = <0>;
        };

        Ngoac_don {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <14 15>;
            layers = <0>;
        };

        Ngoac_kep {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <17 16>;
            layers = <0>;
        };

        Huyen {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        Nga {
            bindings = <&kp TILDE>;
            key-positions = <9 8>;
            layers = <0>;
        };

        Gach_ngang {
            bindings = <&kp MINUS>;
            key-positions = <1 2>;
            layers = <0>;
        };

        Gach_chan {
            bindings = <&kp UNDERSCORE>;
            key-positions = <8 7>;
            layers = <0>;
        };

        Dau_bang {
            bindings = <&kp EQUAL>;
            key-positions = <2 3>;
            layers = <0>;
        };

        Dau_cong {
            bindings = <&kp PLUS>;
            key-positions = <7 6>;
            layers = <0>;
        };

        Gach_ngieng {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <3 4>;
            layers = <0>;
        };

        Gach_thang {
            bindings = <&kp PIPE>;
            key-positions = <6 5>;
            layers = <0>;
        };

        Home {
            bindings = <&kp HOME>;
            key-positions = <11 0>;
            layers = <0>;
        };

        Page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <12 1>;
            layers = <0>;
        };

        Page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <13 2>;
            layers = <0>;
        };

        End {
            bindings = <&kp END>;
            key-positions = <14 3>;
            layers = <0>;
        };

        Di_chuot_trai {
            bindings = <&mmv MOVE_LEFT>;
            key-positions = <17 6>;
            layers = <0 1 2>;
        };

        Di_chuot_len {
            bindings = <&mmv MOVE_UP>;
            key-positions = <18 7>;
            layers = <0 1 2>;
        };

        Di_chuot_xuong {
            bindings = <&mmv MOVE_DOWN>;
            key-positions = <19 8>;
            layers = <0 1 2>;
        };

        Di_chuot_phai {
            bindings = <&mmv MOVE_RIGHT>;
            key-positions = <20 9>;
            layers = <0 1 2>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <18 17 19>;
            layers = <0 1 2>;
        };

        CSA {
            bindings = <&CSA>;
            key-positions = <12 13 14>;
            layers = <0>;
        };

        Left_arrow {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <11 23>;
            layers = <0>;
        };

        Down_arrow {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <24 12>;
            layers = <0>;
        };

        Up_arrow {
            bindings = <&kp UP_ARROW>;
            key-positions = <25 13>;
            layers = <0>;
        };

        Right_arrow {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <26 14>;
            layers = <0>;
        };

        Mui_ten_thuan {
            bindings = <&Mui_ten_thuan>;
            key-positions = <15 27>;
            layers = <0>;
        };

        Mui_ten_nguoc {
            bindings = <&Mui_ten_nguoc>;
            key-positions = <28 16>;
            layers = <0>;
        };

        Khoa_Number {
            bindings = <&to 1>;
            key-positions = <37 20>;
            layers = <0>;
        };

        Khoa_Mouse {
            bindings = <&to 3>;
            key-positions = <20 38>;
            layers = <0>;
        };

        Default {
            bindings = <&to 0>;
            key-positions = <38 37>;
            layers = <0 2 3 4>;
        };

        Chuot_trai {
            bindings = <&mkp LCLK>;
            key-positions = <1 2 3>;
            layers = <0>;
        };

        Chuot_phai {
            bindings = <&mkp RCLK>;
            key-positions = <24 25 26>;
            layers = <0>;
        };

        Mo_ngoac_Number {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 28>;
            layers = <1>;
        };

        Dong_ngoac_number {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <32 20>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            display-name = "DEFAULT";
            bindings = <
                   &kp Q         &kp W       &kp E            &kp R                 &kp T  &kp Y  &kp U           &kp I          &kp O       &kp P
&mt ESC TAB        &kp A         &kp S       &kp D            &kp F                 &kp G  &kp H  &kp J           &kp K          &kp L       &kp SEMI  &kp LEFT_GUI
&lt 4 PRINTSCREEN  &kp Z         &kp X       &kp C            &kp V                 &kp B  &kp N  &kp M           &kp COMMA      &kp DOT     &kp FSLH  &kp LEFT_ALT
                                 &kp LC(N0)  &mt LCTRL SPACE  &mt LEFT_SHIFT ENTER  &mo 1  &mo 3  &lt 4 CAPSLOCK  &kp BACKSPACE  &kp C_MUTE
&msc SCRL_LEFT     &msc SCRL_UP  &mkp RCLK   &msc SCRL_DOWN   &msc SCRL_RIGHT                     &kp LEFT        &kp DOWN       &mkp LCLK   &kp UP    &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp LC(MINUS) LC(EQUAL)>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        NUMBER {
            display-name = "NUMBER";
            bindings = <
                                 &kp NUMBER_1    &kp NUMBER_2      &kp NUMBER_3            &kp NUMBER_4          &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7        &kp NUMBER_8        &kp NUMBER_9  &kp NUMBER_0
&mt ESCAPE TAB                   &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW            &kp RIGHT_ARROW       &mo 2         &kp PLUS      &kp NUMBER_4        &kp NUMBER_5        &kp NUMBER_6  &kp ASTERISK      &kp LEFT_GUI
&mt LG(PRINTSCREEN) PRINTSCREEN  &kp LC(C)       &kp LC(X)         &kp LC(V)               &kp LC(LS(V))         &kp LG(V)     &kp MINUS     &kp NUMBER_1        &kp NUMBER_2        &kp NUMBER_3  &kp SLASH         &kp LEFT_ALT
                                                 &kp LC(NUMBER_0)  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT ENTER  &mo 1         &mo 3         &mt EQUAL NUMBER_0  &kp BACKSPACE       &kp C_MUTE
&msc SCRL_LEFT                   &msc SCRL_UP    &none             &msc SCRL_DOWN          &msc SCRL_RIGHT                                   &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &none         &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)
            >;

            sensor-bindings =
                <&inc_dec_kp LC(MINUS) LC(EQUAL)>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        FUNCTION {
            display-name = "FUNCTION";
            bindings = <
                                 &kp F1          &kp F2            &kp F3                  &kp F4                &kp F5     &kp F6     &kp F7              &kp F8          &kp F9      &kp F12
&mt ESCAPE TAB                   &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW            &kp RIGHT_ARROW       &none      &kp PLUS   &kp F4              &kp F5          &kp F6      &kp F11       &kp LEFT_GUI
&mt LG(PRINTSCREEN) PRINTSCREEN  &kp LC(C)       &kp LC(X)         &kp LC(V)               &kp LC(LS(V))         &kp LG(V)  &kp MINUS  &kp F1              &kp F2          &kp F3      &kp F10       &kp LEFT_ALT
                                                 &kp LC(NUMBER_0)  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT ENTER  &mo 1      &mo 3      &mt EQUAL NUMBER_0  &kp BACKSPACE   &kp C_MUTE
&msc SCRL_LEFT                   &msc SCRL_UP    &none             &msc SCRL_DOWN          &msc SCRL_RIGHT                             &kp LEFT_ARROW      &kp DOWN_ARROW  &none       &kp UP_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp LC(MINUS) LC(PLUS)>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
                                 &mkp MB4        &mkp MB5        &mkp MCLK       &Triple_left_click  &none   &none                 &none              &CW               &kp LA(F4)       &kp C_SLEEP_MODE
&mt ESCAPE TAB                   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT     &none   &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_MUTE        &kp C_VOLUME_UP  &kp C_SLEEP           &kp LEFT_GUI
&mt LG(PRINTSCREEN) PRINTSCREEN  &mkp MB4        &mkp MB5        &mkp MCLK       &Triple_left_click  &trans  &kp C_BRIGHTNESS_DEC  &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &kp C_AL_SCREENSAVER  &kp LEFT_ALT
                                                 &none           &mkp LCLK       &mkp RCLK           &mo 1   &mo 3                 &none              &none             &none
&kp LEFT_ARROW                   &kp UP_ARROW    &none           &kp DOWN_ARROW  &kp RIGHT_ARROW                                   &msc SCRL_LEFT     &msc SCRL_DOWN    &none            &msc SCRL_UP          &msc SCRL_RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        MIRROR {
            bindings = <
                &kp P          &kp O       &kp I                     &kp U          &kp Y  &kp T  &kp R  &kp E  &kp W  &kp Q
&mt ESCAPE TAB  &kp SEMICOLON  &kp L       &kp K                     &kp J          &kp H  &kp G  &kp F  &kp D  &kp S  &kp A  &mt LEFT_SHIFT SPACE
&none           &kp SLASH      &kp PERIOD  &kp COMMA                 &kp M          &kp N  &kp B  &kp V  &kp C  &kp X  &kp Z  &kp BACKSPACE
                               &none       &mt RIGHT_SHIFT CAPSLOCK  &kp BACKSPACE  &none  &none  &none  &none  &none
&none           &none          &none       &none                     &none                        &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };
    };
};
