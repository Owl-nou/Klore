#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };
    };

    macros {
        Full_Prt_Scr: Full_Prt_Scr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp PRINTSCREEN>;
            label = "FULL_PRT_SCR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            display-name = "DEFAULT";
            bindings = <
                                 &kp Q         &kp W          &kp E            &kp R                 &kp T      &kp Y      &kp U          &kp I      &kp O       &kp P
&mt ESC TAB                      &kp A         &kp S          &kp D            &kp F                 &kp G      &kp H      &kp J          &kp K      &kp L       &kp SEMI  &kp LEFT_GUI
&mt LG(PRINTSCREEN) PRINTSCREEN  &kp Z         &kp X          &kp C            &kp V                 &kp B      &kp N      &kp M          &kp COMMA  &kp DOT     &kp FSLH  &kp LEFT_ALT
                                               &kp C_AC_ZOOM  &mt LCTRL ENTER  &mt LEFT_SHIFT SPACE  &kp SPACE  &kp SPACE  &kp BACKSPACE  &kp LCTRL  &kp K_MUTE
&msc SCRL_LEFT                   &msc SCRL_UP  &trans         &msc SCRL_DOWN   &msc SCRL_RIGHT                             &kp LEFT       &kp DOWN   &trans      &kp UP    &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        NUMBER {
            display-name = "NUMBER";
            bindings = <
                                 &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3            &kp NUMBER_4          &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8        &kp NUMBER_9  &kp NUMBER_0
&mt ESCAPE TAB                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW            &kp RIGHT_ARROW       &mo 2         &kp PLUS      &kp NUMBER_4   &kp NUMBER_5        &kp NUMBER_6  &kp ASTERISK  &kp LEFT_GUI
&mt LG(PRINTSCREEN) PRINTSCREEN  &kp LC(C)       &kp LC(X)       &kp LC(V)               &kp LC(LS(V))         &kp LG(V)     &kp MINUS     &kp NUMBER_1   &kp NUMBER_2        &kp NUMBER_3  &kp SLASH     &kp LEFT_ALT
                                                 &kp             &mt LEFT_CONTROL ENTER  &mt LEFT_SHIFT SPACE  &kp           &kp           &kp BACKSPACE  &mt EQUAL NUMBER_0  &kp
&kp                              &kp             &kp             &kp                     &kp                                               &kp            &kp                 &kp           &kp           &kp
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        FUNCTION {
            display-name = "NUMBER";
            bindings = <
                                 &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3            &kp NUMBER_4          &kp NUMBER_5  &kp NUMBER_6  &kp F7         &kp F8              &kp F9  &kp F12
&mt ESCAPE TAB                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW            &kp RIGHT_ARROW       &trans        &kp PLUS      &kp F4         &kp F5              &kp F6  &kp F11  &kp LEFT_GUI
&mt LG(PRINTSCREEN) PRINTSCREEN  &kp LC(C)       &kp LC(X)       &kp LC(V)               &kp LC(LS(V))         &kp LG(V)     &kp MINUS     &kp F1         &kp F2              &kp F3  &kp F10  &kp LEFT_ALT
                                                 &trans          &mt LEFT_CONTROL ENTER  &mt LEFT_SHIFT SPACE  &mo 1         &mo 3         &kp BACKSPACE  &mt EQUAL NUMBER_0  &trans
&kp                              &kp             &kp             &kp                     &kp                                               &kp            &kp                 &kp     &kp      &kp
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        FN {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        layer_5 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        layer_6 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };
    };
};
